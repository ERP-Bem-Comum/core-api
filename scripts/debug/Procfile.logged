http: bash scripts/debug/run-http-with-e2e-env.sh 2>&1 | tee -a .tmp/logs/http.jsonl
worker-outbox: WORKER_GROUP=outbox node --enable-source-maps src/workers/runner/run.ts 2>&1 | tee -a .tmp/logs/worker-outbox.jsonl
worker-projections: WORKER_GROUP=projections node --enable-source-maps src/workers/runner/run.ts 2>&1 | tee -a .tmp/logs/worker-projections.jsonl
worker-email: WORKER_GROUP=email node --enable-source-maps src/workers/runner/run.ts 2>&1 | tee -a .tmp/logs/worker-email.jsonl
worker-van: WORKER_GROUP=van node --enable-source-maps src/workers/runner/run.ts 2>&1 | tee -a .tmp/logs/worker-van.jsonl
