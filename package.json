{
  "name": "core-api",
  "version": "1.0.0-rc.3",
  "description": "Backend do ERP Bem Comum — modular monolith em Node.js e TypeScript, com borda HTTP em Fastify e persistência MySQL via Drizzle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERP-Bem-Comum/core-api.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "imports": {
    "#src/*": "./src/*",
    "#scripts/*": "./scripts/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "preinstall": "node --enable-source-maps scripts/ci/only-allow-pnpm.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "docs:inventory": "node --enable-source-maps scripts/handbook/inventory.ts",
    "docs:index": "node --enable-source-maps scripts/handbook/inquiry-index.ts",
    "docs:refs": "node --enable-source-maps scripts/handbook/refs.ts",
    "docs:links": "node --enable-source-maps scripts/handbook/link-scan.ts",
    "wiki:sync": "node --enable-source-maps scripts/handbook/wiki-sync.ts",
    "cnab:index": "node --enable-source-maps scripts/financial/cnab-manual-index.ts",
    "logbook": "node --enable-source-maps scripts/claude/logbook.ts",
    "release:notes": "node --enable-source-maps scripts/ci/release-notes.ts",
    "audit": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit --audit-level=high",
    "test": "node --enable-source-maps --test --test-concurrency=6 'tests/**/*.test.ts'",
    "test:integration": "node --enable-source-maps scripts/ci/test-integration.ts contracts",
    "worker:outbox": "node --enable-source-maps src/modules/contracts/worker/run.ts",
    "worker:outbox:partners": "node --enable-source-maps src/modules/partners/worker/run.ts",
    "worker:supplier-projection": "node --enable-source-maps src/workers/supplier-view-projection/run.ts",
    "worker:payable-projection": "node --enable-source-maps src/workers/payable-view-projection/run.ts",
    "worker:contract-count-projection": "node --enable-source-maps src/workers/contract-count-projection/run.ts",
    "worker:email-dispatch": "node --enable-source-maps src/workers/email-dispatch/run.ts",
    "job:contracts:sweep": "node --enable-source-maps src/jobs/contracts/sweeper/run.ts",
    "job:financial:supplier-view-backfill": "node --enable-source-maps src/jobs/financial/supplier-view-backfill/run.ts",
    "job:financial:payable-view-backfill": "node --enable-source-maps src/jobs/financial/payable-view-backfill/run.ts",
    "job:partners:contract-count-backfill": "node --enable-source-maps src/jobs/partners/contract-count-backfill/run.ts",
    "job:outbox-sweeper": "node --enable-source-maps src/jobs/shared/outbox-sweeper/run.ts",
    "job:migrate": "node --enable-source-maps src/jobs/migrate/run.ts",
    "job:auth:sync-permissions": "node --enable-source-maps src/jobs/auth/sync-permissions/run.ts",
    "secrets:setup": "node --enable-source-maps scripts/setup/secrets.ts",
    "test:integration:infra": "node --enable-source-maps scripts/ci/test-integration.ts infra",
    "test:integration:notifications": "node --enable-source-maps scripts/ci/test-integration.ts notifications",
    "test:integration:storage": "node --enable-source-maps scripts/ci/test-integration.ts storage",
    "test:integration:auth": "node --enable-source-maps scripts/ci/test-integration.ts auth",
    "test:integration:partners": "node --enable-source-maps scripts/ci/test-integration.ts partners",
    "test:integration:programs": "node --enable-source-maps scripts/ci/test-integration.ts programs",
    "test:integration:budget-plans": "node --enable-source-maps scripts/ci/test-integration.ts budget-plans",
    "test:integration:financial": "node --enable-source-maps scripts/ci/test-integration.ts financial",
    "test:integration:etl": "node --enable-source-maps scripts/ci/test-integration.ts etl",
    "test:integration:etl:orchestrate": "node --enable-source-maps scripts/ci/test-integration.ts etl:orchestrate",
    "test:integration:etl:contracts": "node --enable-source-maps scripts/ci/test-integration.ts etl:contracts",
    "test:integration:etl:financial": "node --enable-source-maps scripts/ci/test-integration.ts etl:financial",
    "etl:check-duplicates": "node --enable-source-maps scripts/etl/diagnostics/check-duplicates.ts",
    "serve": "node --enable-source-maps src/server.ts",
    "dev": "overmind start",
    "test:e2e:auth": "bash scripts/e2e/auth.sh",
    "test:e2e:contracts": "bash scripts/e2e/contracts.sh",
    "test:e2e:collaborators": "bash scripts/e2e/collaborators.sh",
    "test:integration:photo": "node --enable-source-maps scripts/ci/test-integration.ts photo",
    "test:integration:logo": "node --enable-source-maps scripts/ci/test-integration.ts logo",
    "db:generate": "drizzle-kit generate --config db/drizzle/contracts.ts",
    "db:generate:auth": "drizzle-kit generate --config db/drizzle/auth.ts",
    "db:generate:partners": "drizzle-kit generate --config db/drizzle/partners.ts",
    "db:generate:programs": "drizzle-kit generate --config db/drizzle/programs.ts",
    "db:generate:financial": "drizzle-kit generate --config db/drizzle/financial.ts",
    "db:generate:notifications": "drizzle-kit generate --config db/drizzle/notifications.ts",
    "db:generate:budget-plans": "drizzle-kit generate --config db/drizzle/budget-plans.ts",
    "db:seed:partners": "node --enable-source-maps scripts/seed/partners.ts",
    "seed:admin": "node --enable-source-maps scripts/seed/admin-user.ts",
    "financial:projection-health": "node --enable-source-maps scripts/financial/diagnostics/projection-health.ts",
    "financial:payee-bank-distribution": "node --enable-source-maps scripts/financial/diagnostics/payee-bank-distribution.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.8.3",
    "typescript": "7.0.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1052.0",
    "@aws-sdk/s3-request-presigner": "3.1052.0",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.6",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.7.3",
    "fastify": "5.12.5",
    "fastify-zod-openapi": "5.6.1",
    "hash-wasm": "4.12.0",
    "jose": "6.2.3",
    "mysql2": "3.23.1",
    "nodemailer": "10.0.15",
    "resend": "6.12.4",
    "unpdf": "1.6.2",
    "zod": "4.4.3",
    "zod-openapi": "5.4.6"
  }
}
