diff --git a/tests/modules/financial/application/use-cases/edit-cedente-account.test.ts b/tests/modules/financial/application/use-cases/edit-cedente-account.test.ts
index 4158e85b..ed93907a 100644
--- a/tests/modules/financial/application/use-cases/edit-cedente-account.test.ts
