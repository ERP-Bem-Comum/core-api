# .env.example — variáveis lidas por src/server.ts e src/shared/http/config.ts
# Copie para .env (ou .env.local) e preencha os valores reais.
# NUNCA commite arquivos com valores reais. .env está no .gitignore.

# ---------------------------------------------------------------------------
# HTTP server (src/shared/http/config.ts)
# ---------------------------------------------------------------------------

# Porta TCP do servidor. Default: 3000.
PORT=3000

# Endereço de bind. Default: 0.0.0.0 (todas as interfaces).
HOST=0.0.0.0

# Origens permitidas pelo CORS — lista separada por vírgula.
# Vazio → CORS desabilitado (seguro para API interna sem browser direto).
CORS_ORIGINS=http://localhost:5173

# Rate limit global (todas as rotas exceto login/refresh).
# Default: 200 req / 1 minute.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# Confiança em X-Forwarded-For/Proto. true | false | CIDR (ex.: 10.0.0.0/8).
# Default: true (core atrás do BFF). Em prod, setar o CIDR real do BFF.
TRUST_PROXY=true

# Timeout em ms para requests lentas (anti-slowloris). Default: 30000.
REQUEST_TIMEOUT_MS=30000

# Keep-alive de conexão ociosa em ms. Default: 72000.
# Deve ser maior que o timeout do load balancer (ex.: AWS ALB = 60 s).
KEEP_ALIVE_TIMEOUT_MS=72000

# ---------------------------------------------------------------------------
# Auth module (src/modules/auth/public-api/http.ts)
# ---------------------------------------------------------------------------

# Driver do repositório auth. "memory" (dev/testes) | "mysql" (prod).
AUTH_DRIVER=memory

# Connection string MySQL do banco de auth (obrigatório se AUTH_DRIVER=mysql).
# Formato: mysql://user:password@host:port/database
AUTH_DATABASE_URL=mysql://auth_user:secret@127.0.0.1:3306/core_auth

# Rate limit dedicado para rotas sensíveis (login, refresh).
# Ausente ou inválido → default 5 req / 1 minute (BE-REC-001).
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute

# URL base para links de reset de senha nos e-mails (BE-REC-003).
# Nunca lido do header Host — deve ser configurado explicitamente.
# Ausente → default de dev (http://localhost:5173).
AUTH_RESET_BASE_URL=https://app.example.com

# Seed RBAC para E2E/dev — inerte fora de ambiente com CORE_API_E2E=1.
# Valor: JSON stringificado do objeto de seed. Não setar em prod.
# CORE_API_E2E=1
# AUTH_SEED_JSON=

# ---------------------------------------------------------------------------
# Contracts module (src/modules/contracts/public-api/http.ts)
# ---------------------------------------------------------------------------

# Driver do repositório de contratos. "memory" (dev/testes) | "mysql" (prod).
CONTRACTS_DRIVER=memory

# Connection string MySQL — writer (obrigatório se CONTRACTS_DRIVER=mysql).
# ADR-0026: RW split; CONTRACTS_DATABASE_URL é o nó escritor.
CONTRACTS_DATABASE_URL=mysql://contracts_user:secret@127.0.0.1:3306/core_contracts

# Réplica de leitura (opcional — ausente reusa CONTRACTS_DATABASE_URL, single-node).
# ADR-0026: reads roteiam para este nó quando presente.
CONTRACTS_READER_URL=mysql://contracts_user:secret@127.0.0.1:3307/core_contracts
