# ============================================================================
# ARQUIVO GERADO — não editar à mão.
#
# Fonte: src/deploy/env-catalog.ts + src/deploy/workloads.ts
# Regenerar: pnpm run env:generate
# Conferido por: tests/cleanup/env-artifacts-generated.test.ts
#
# Toda variável lida é obrigatória em TODO ambiente (ADR-0068): ausente, o processo não sobe
# e diz qual campo falta. Os valores abaixo são de DESENVOLVIMENTO — nunca credencial nem
# dado real, porque este arquivo é versionado e os repositórios são públicos.
# ============================================================================

# ─── OBRIGATÓRIAS — sem estas o processo NÃO sobe ────────────────────────────

# Conexão de escrita do `auth`.
# lida em: src/shared/persistence/module-driver-config.ts
AUTH_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# `mysql` ou `memory`. ⚠️ `memory` só vale em desenvolvimento — o ADR-0068 revoga o FR-007, e
# driver em memória declarado não sobe em homologação nem produção.
# lida em: src/shared/persistence/module-driver-config.ts
AUTH_DRIVER=mysql

# Conexão de escrita do `budget-plans`.
# lida em: src/shared/persistence/module-driver-config.ts
BUDGET_PLANS_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Driver de persistência do `budget-plans`. Ver `AUTH_DRIVER`.
# lida em: src/shared/persistence/module-driver-config.ts
BUDGET_PLANS_DRIVER=mysql

# Conexão de escrita do `contracts`.
# lida em: src/shared/persistence/module-driver-config.ts
CONTRACTS_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Driver de persistência do `contracts`. Ver `AUTH_DRIVER`.
# lida em: src/shared/persistence/module-driver-config.ts
CONTRACTS_DRIVER=mysql

# Conexão de escrita do `financial`.
# lida em: src/shared/persistence/module-driver-config.ts
FINANCIAL_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Driver de persistência do `financial`. Ver `AUTH_DRIVER`.
# lida em: src/shared/persistence/module-driver-config.ts
FINANCIAL_DRIVER=mysql

# Conexão usada pelo job `migrate`. Separada porque o boot NÃO migra: o schema é provisionado
# antes do deploy, para evitar corrida entre instâncias.
# lida em: src/jobs/migrate/config.ts
MIGRATE_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Conexão de escrita do `partners`.
# lida em: src/shared/persistence/module-driver-config.ts
PARTNERS_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Driver de persistência do `partners`. Ver `AUTH_DRIVER`.
# lida em: src/shared/persistence/module-driver-config.ts
PARTNERS_DRIVER=mysql

# Conexão de escrita do `programs`.
# lida em: src/shared/persistence/module-driver-config.ts
PROGRAMS_DATABASE_URL=mysql://dev:dev@localhost:3306/core

# Driver de persistência do `programs`. Ver `AUTH_DRIVER`.
# lida em: src/shared/persistence/module-driver-config.ts
PROGRAMS_DRIVER=mysql

# Bucket do logo de programa. ⚠️ A ausência deste bloco derrubou o ambiente de homologação por
# 4h20 em 24/08/2026 (#842): o fail-fast é deliberado, e o que faltava era a declaração.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_BUCKET=core-api-programs-logo

# Endpoint S3 do logo de programa.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_ENDPOINT=http://localhost:9000

# Driver do `reports`. ⚠️ Ausente, a degradação silenciosa para `memory` devolvia HTTP 200 com
# lista vazia — foi o que os incidentes #374 e #444 sofreram, e a razão do fail-fast do #456.
# lida em: src/shared/persistence/module-driver-config.ts
REPORTS_DRIVER=mysql

# Bucket de documentos.
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_BUCKET=contracts-documents

# Região do bucket de documentos (fiscal do `financial`, foto do colaborador).
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_REGION=us-east-1

# Bucket da VAN. ⚠️ Gravar objeto no prefixo de saída deste bucket É enfileirar pagamento
# (ADR-0060) — em produção, errar o nome do bucket é a diferença entre ensaio e dinheiro.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_BUCKET=core-api-van

# Região do bucket da VAN. ⚠️ Obrigatória para o processo `http`, não só para o grupo `van`:
# `buildVanStorage` lança no boot e é chamado de forma eager na composição do `financial` sob
# `FINANCIAL_DRIVER=mysql`. Foi a ausência desta e de `VAN_S3_BUCKET` no `.env.example` que
# impedia um clone novo de subir (#1059).
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_REGION=us-east-1

# Qual grupo de workers o processo executa: `outbox`, `projections`, `email` ou `van`. Um processo
# por grupo, não um por worker (consolidação #407). Valor inválido faz o runner recusar o boot.
# lida em: src/workers/runner/run.ts
# NÃO declare aqui — o valor é o grupo DAQUELE processo. No `.env` ele valeria para os quatro, e
# os quatro rodariam o mesmo grupo — o `Procfile` e o `compose.yaml` o passam inline, um por
# serviço.
# WORKER_GROUP=outbox

# ─── EXIGIDAS POR RELAÇÃO — ver o bloco de relações no fim ───────────────────

# Alias legado do remetente de convite. Ver `EMAIL_FROM`.
# lida em: src/modules/notifications/adapters/email/email-config.ts
AUTH_INVITE_FROM=

# Alias legado do remetente de redefinição. Ver `EMAIL_FROM`.
# lida em: src/modules/notifications/adapters/email/email-config.ts
AUTH_RESET_FROM=

# Caminho de arquivo com a conexão do `contracts`, para secret montado como volume. ⚠️ Mutuamente
# exclusiva com `CONTRACTS_DATABASE_URL` — as duas juntas devolvem
# `sweeper-ambiguous-connection-config`.
# lida em: src/jobs/contracts/sweeper/config.ts
CONTRACTS_DATABASE_URL_FILE=

# Remetente padrão. ⚠️ Pelo menos UM dos remetentes precisa existir, senão a spec de e-mail não
# monta.
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_FROM=nao-responda@example.test

# Remetente específico do convite. Ver `EMAIL_FROM`.
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_FROM_INVITE=

# Remetente específico da redefinição de senha. Ver `EMAIL_FROM`.
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_FROM_RESET=

# ─── COM DEFAULT NO CÓDIGO — ausência não derruba o boot ─────────────────────

# Tentativas de login por janela. Separado do limite geral porque é defesa contra força bruta, não
# contra abuso de uso.
# lida em: src/server.ts
AUTH_LOGIN_RATE_LIMIT_MAX=5

# Janela do rate limit de login.
# lida em: src/server.ts
AUTH_LOGIN_RATE_LIMIT_WINDOW=15 minutes

# `enforced` ou `bypass`. ⚠️ Hoje NÃO é lida: o modo está fixado em `bypass` por código
# (`server.ts`, duas linhas marcadas `← religar`), e sob bypass todo autenticado aprova qualquer
# valor. Religar é a #634; o boot emite banner quando esta variável e o modo fixo divergem.
# lida em: src/modules/auth/adapters/http/rbac-mode.ts
# default no código: enforced
AUTH_RBAC_MODE=enforced

# Semente de usuários para a suíte E2E, em JSON. Só tem efeito com `CORE_API_E2E` ligada.
# lida em: src/modules/auth/adapters/http/e2e-seed.ts
AUTH_SEED_JSON=

# Réplica de leitura do `contracts` (ADR-0026). Ausente, o reader reusa o writer — single-node. Só
# `contracts` e `partners` têm split.
# lida em: src/server.ts
CONTRACTS_READER_URL=

# Liga as rotas de semente usadas pela suíte E2E. ⚠️ Nunca ligar em ambiente com dado real: elas
# escrevem direto no banco, sem passar pelas regras de domínio.
# lida em: src/modules/auth/adapters/http/e2e-seed.ts
CORE_API_E2E=false

# Origens aceitas pelo CORS, separadas por vírgula.
# lida em: src/shared/http/config.ts
CORS_ORIGINS=http://localhost:5173

# Domínios aceitos como remetente, separados por vírgula. Recusa envio de domínio não autorizado
# antes de tentar o provedor.
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_FROM_ALLOWED_DOMAINS=example.test

# Remetente das notificações gerais.
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_FROM_NOTIFICATION=

# Provedor de envio: `smtp`, `resend` ou `memory`. ⚠️ Ausente, o worker cai em `memory` e DESCARTA
# todo e-mail de reset e convite, com boot verde (#1047).
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_PROVIDER=smtp

# E-mails por janela, para não estourar a cota do provedor.
# lida em: src/modules/notifications/adapters/email/rate-limit.ts
EMAIL_RATE_LIMIT_MAX=

# Janela do rate limit de e-mail.
# lida em: src/modules/notifications/adapters/email/rate-limit.ts
EMAIL_RATE_LIMIT_WINDOW_MS=

# Redireciona TODO e-mail para este destinatário, qualquer que seja o original. Comportamento de
# decorator, aplicado num ponto só (ADR-0010).
# lida em: src/modules/notifications/adapters/email/email-config.ts
EMAIL_SANDBOX_TO=

# Interface em que a borda HTTP escuta.
# lida em: src/shared/http/config.ts
# default no código: 0.0.0.0
HOST=127.0.0.1

# Tempo que uma conexão ociosa sobrevive. Deve ser maior que o do load balancer à frente, senão o
# balanceador reusa conexão que o servidor já fechou.
# lida em: src/shared/http/config.ts
KEEP_ALIVE_TIMEOUT_MS=72000

# Nível do logger Pino da borda e dos workers.
# lida em: src/shared/http/app.ts
# default no código: info
LOG_LEVEL=info

# Ambiente de execução. `production` ativa as exigências de `envProductionOnly` e desliga toda
# degradação graciosa (ADR-0068).
# lida em: src/shared/runtime/node-env.ts
# default no código: development
NODE_ENV=development

# Quantos eventos cada claim reivindica por rodada.
# lida em: src/modules/contracts/worker/config.ts
OUTBOX_BATCH_SIZE=50

# Identidade do consumidor no par `(consumidor, evento)`. ⚠️ A pendência é por consumidor, não da
# linha: o mesmo evento é entregue a N consumidores (fanout), e usar um id compartilhado faz dois
# consumidores dividirem os eventos em vez de cada um receber todos.
# lida em: src/shared/outbox/registered-consumers.ts
OUTBOX_CONSUMER_ID=worker-outbox-local

# Pausa quando o claim não encontra evento pendente.
# lida em: src/modules/contracts/worker/config.ts
OUTBOX_IDLE_SLEEP_MS=1000

# Arquivo de log do relay, quando se quer a saída fora do stdout.
# lida em: src/modules/contracts/worker/config.ts
OUTBOX_LOG_FILE=

# Tentativas antes de o evento ir para dead-letter. ⚠️ O dead-letter é por CONSUMIDOR e terminal,
# e nunca apaga a linha de origem (ADR-0064).
# lida em: src/modules/contracts/worker/config.ts
OUTBOX_MAX_ATTEMPTS=5

# Intervalo de polling do outbox. MySQL não tem `LISTEN/NOTIFY`, então a leitura é sempre polling
# (ADR-0015).
# lida em: src/modules/contracts/worker/config.ts
OUTBOX_POLL_MS=500

# Réplica de leitura do `partners`. Ver `CONTRACTS_READER_URL`.
# lida em: src/server.ts
PARTNERS_READER_URL=

# Porta da borda HTTP. ⚠️ Sob `pnpm run dev` o overmind define `PORT` por processo, então a porta
# efetiva não é esta — conferir com `overmind status`.
# lida em: src/shared/http/config.ts
# default no código: 3000
PORT=3000

# Chave de acesso ao bucket de logo.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_ACCESS_KEY_ID=dev

# Endereçamento por path no bucket de logo. Ver `S3_FORCE_PATH_STYLE`.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_FORCE_PATH_STYLE=true

# Região do bucket de logo.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_REGION=us-east-1

# Segredo da chave do bucket de logo.
# lida em: src/modules/programs/adapters/http/logo-storage-config.ts
PROGRAMS_LOGO_S3_SECRET_ACCESS_KEY=devpassword

# Requisições permitidas por janela, por cliente, nas rotas gerais.
# lida em: src/shared/http/config.ts
RATE_LIMIT_MAX=100

# Duração da janela do rate limit geral.
# lida em: src/shared/http/config.ts
RATE_LIMIT_WINDOW=1 minute

# Sobrescreve a origem de planos nas leituras do `reports`.
# lida em: src/shared/persistence/module-driver-config.ts
REPORTS_BUDGET_PLANS_DATABASE_URL=

# Sobrescreve a origem de contratos nas leituras do `reports`.
# lida em: src/shared/persistence/module-driver-config.ts
REPORTS_CONTRACTS_DATABASE_URL=

# Conexão do `reports`. Primeiro elo da cascata `REPORTS_* ?? <módulo-fonte>_*`: o `reports` é
# read-only e não tem base própria.
# lida em: src/shared/persistence/module-driver-config.ts
REPORTS_DATABASE_URL=

# Sobrescreve a origem financeira nas leituras do `reports`.
# lida em: src/shared/persistence/module-driver-config.ts
REPORTS_FINANCIAL_DATABASE_URL=

# Teto de duração de uma requisição na borda.
# lida em: src/shared/http/config.ts
REQUEST_TIMEOUT_MS=30000

# Credencial do provedor Resend. Só usada com `EMAIL_PROVIDER=resend`.
# lida em: src/modules/notifications/adapters/email/resend-config.ts
RESEND_API_KEY=

# Chave de acesso ao bucket de documentos. ⚠️ Vai JUNTO com `S3_SECRET_ACCESS_KEY`; ausentes as
# duas, o SDK cai na provider chain do IAM — que é o caminho de produção.
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_ACCESS_KEY_ID=dev

# Endpoint S3. Preenchido aponta para o S3 local; vazio usa o endpoint padrão da AWS.
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_ENDPOINT=http://localhost:9000

# Endereçamento por path em vez de subdomínio. Obrigatório contra S3 local; desnecessário na AWS.
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_FORCE_PATH_STYLE=true

# Segredo da chave de acesso. Ver `S3_ACCESS_KEY_ID`.
# lida em: src/modules/contracts/adapters/storage/s3-config-aws.ts
S3_SECRET_ACCESS_KEY=devpassword

# Host SMTP. A `~/.infra` sobe o Mailpit, com UI em `http://localhost:8025`.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_HOST=localhost

# Teto de conexões simultâneas no pool SMTP.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_MAX_CONNS=

# Senha SMTP. Vazio em servidor local sem autenticação.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_PASS=

# Reaproveita conexões SMTP em vez de abrir uma por envio.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_POOL=

# Porta SMTP.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_PORT=1025

# Exige STARTTLS e recusa a conexão sem ele.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_REQUIRE_TLS=false

# TLS desde a conexão (porta 465). Falso usa STARTTLS quando disponível.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_SECURE=false

# Usuário SMTP. Vazio em servidor local sem autenticação.
# lida em: src/modules/notifications/adapters/email/nodemailer-config.ts
SMTP_USER=

# Contratos processados por rodada na varredura de ciclo de vida.
# lida em: src/jobs/contracts/sweeper/config.ts
SWEEP_BATCH_SIZE=

# Se o Fastify confia nos headers `X-Forwarded-*`. Ligar atrás de load balancer; desligado, o IP
# do cliente é o do proxy e o rate limit passa a contar o balanceador inteiro como um só.
# lida em: src/shared/http/config.ts
TRUST_PROXY=false

# Chave de acesso ao bucket da VAN. ⚠️ Vai JUNTO com `VAN_S3_SECRET_ACCESS_KEY`. Em produção o
# agente usa role da própria instância, sem chave estática (ADR-0061).
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_ACCESS_KEY_ID=dev

# Endpoint S3 do bucket da VAN.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_ENDPOINT=http://localhost:9000

# Endereçamento por path no bucket da VAN. Ver `S3_FORCE_PATH_STYLE`.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_FORCE_PATH_STYLE=true

# Prefixo do que ficou sem confirmação e aguarda revisão humana — nunca retransmitido
# automaticamente. ⚠️ Objeto aqui NÃO prova que o banco não recebeu.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_FAILED=falhas/

# Prefixo da fila de saída — remessa depositada e ainda não transmitida. ⚠️ Escrever aqui É
# enfileirar pagamento.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_OUTBOUND=saida/

# Prefixo do que foi transmitido COM confirmação. Somente leitura para a aplicação.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_PROCESSED=processados/

# Prefixo dos arquivos recebidos do banco. ⚠️ A caixa é do CONVÊNIO: chegam retornos sem
# correspondência com remessa nossa, e o processamento não deve falhar o lote por referência
# desconhecida.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_RETURNS=retorno/

# Prefixo de ensaio. ⚠️ Existe APENAS no bucket de homologação: no de produção não há sandbox, e
# errar o destino exige trocar o nome do bucket, não o prefixo.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_SANDBOX=sandbox/

# Prefixo do envelope de status por execução — a única janela sobre o que o agente fez. A ausência
# de um envelope de recepção significa "rodou e não havia nada", não "não rodou".
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_PREFIX_STATUS=status/

# Segredo da chave do bucket da VAN. Ver `VAN_S3_ACCESS_KEY_ID`.
# lida em: src/modules/financial/adapters/van/van-s3-config.ts
VAN_S3_SECRET_ACCESS_KEY=devpassword

# Chave de acesso ao sandbox da VAN.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_ACCESS_KEY_ID=

# Bucket de sandbox da VAN. Separado do de produção por desenho.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_BUCKET=

# Endpoint S3 do sandbox da VAN.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_ENDPOINT=

# Endereçamento por path no sandbox da VAN.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_FORCE_PATH_STYLE=

# Prefixo usado dentro do bucket de sandbox.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_PREFIX=

# Região do bucket de sandbox da VAN, usado para exercitar o nosso lado do contrato.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_REGION=us-east-1

# Segredo da chave do sandbox da VAN.
# lida em: src/modules/financial/adapters/http/van-sandbox-composition.ts
VAN_SANDBOX_S3_SECRET_ACCESS_KEY=

# Token que autoriza as rotas de sandbox da VAN.
# lida em: src/modules/financial/adapters/http/van-sandbox-auth.ts
VAN_SANDBOX_TOKEN=

# ─── OBRIGATÓRIAS SÓ EM PRODUÇÃO — exigidas sob NODE_ENV=production ──────────

# Base do link de ativação de conta. Ver `AUTH_RESET_BASE_URL`.
# lida em: src/shared/http/email-link-base-urls.ts
# AUTH_ACTIVATION_BASE_URL=

# Chave privada ES256 que assina o token. ⚠️ Classificada como só-produção pelo manifesto, mas sem
# ela o login local não emite token — gerar um par local e mantê-lo FORA do versionamento.
# lida em: src/modules/auth/adapters/http/jwt-key-config.ts
# AUTH_JWT_PRIVATE_KEY=

# Chave pública ES256 que verifica o token. Ver `AUTH_JWT_PRIVATE_KEY`.
# lida em: src/modules/auth/adapters/http/jwt-key-config.ts
# AUTH_JWT_PUBLIC_KEY=

# Base do link de redefinição de senha. Exige URL absoluta `http(s)`; relativa o SPA descarta, e o
# boot falha em produção em vez de enviar e-mail com link quebrado.
# lida em: src/shared/http/email-link-base-urls.ts
# AUTH_RESET_BASE_URL=

# Base do link de autocadastro de parceiro. Ver `AUTH_RESET_BASE_URL`.
# lida em: src/shared/http/email-link-base-urls.ts
# PARTNERS_SELF_REGISTRATION_BASE_URL=

# ─── RELAÇÕES ENTRE VARIÁVEIS ─────────────────────────────────────────────
#
# As listas acima não expressam estas regras:

# [all-or-none] S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY
#   uma sem a outra é config pela metade; ausentes caem na provider chain do IAM (unidade: backend)

# [all-or-none] VAN_S3_ACCESS_KEY_ID + VAN_S3_SECRET_ACCESS_KEY
#   mesmo XOR do bloco S3, aplicado ao bucket da VAN (unidade: backend)

# [at-least-one] EMAIL_FROM + EMAIL_FROM_RESET + AUTH_RESET_FROM + EMAIL_FROM_INVITE + AUTH_INVITE_FROM
#   sem nenhum remetente configurado a spec de e-mail não monta (unidade: worker-email)

# [all-or-none] VAN_S3_ACCESS_KEY_ID + VAN_S3_SECRET_ACCESS_KEY
#   XOR de credenciais; ausentes caem na provider chain do IAM (unidade: worker-van)

# [xor] CONTRACTS_DATABASE_URL + CONTRACTS_DATABASE_URL_FILE
#   as duas juntas devolvem sweeper-ambiguous-connection-config (unidade: contracts-sweeper)
